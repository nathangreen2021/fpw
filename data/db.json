      "id": "03a9eea9-2276-468f-9200-756bbc3f27ba",
      "date": "2026-10-19",
      "title": "Compromised Running",
      "focus": "Engine + Strength",
      "notes": "Run splits should stay within 10 s of each other. If round 4 is 20 s+ slower, you went out too hot.",
      "duration": 60,
      "blocks": [
        {
          "title": "Warm-up",
          "format": "10 min",
          "details": "500 m easy row\n2 rounds: 10 air squats, 10 walking lunges, 5 inchworms, 10 band pull-aparts\n3 × 20 s strides building to race pace"
        },
        {
          "title": "Strength — Back Squat",
          "format": "5 × 5 @ 75% · rest 2:00",
          "details": "3 s lowering, drive up hard\nLog a heavy single if you test your 1RM",
          "pbEvent": "back_squat_1rm"
        },
        {
          "title": "Compromised Runs",
          "format": "4 rounds for time · rest 2:00",
          "details": "1 km run @ HYROX race pace\n20 wall balls (9 kg / 6 kg)\n15 cal SkiErg\nGoal: hold the same run split every round",
          "pbEvent": "run_1k"
        },
        {
          "title": "Cool-down",
          "format": "8 min",
          "details": "Easy walk 3 min\nCouch stretch 1 min / side\nPigeon 1 min / side"
        }
      ],
      "published": true,
      "createdAt": "2026-10-30T02:59:08.941Z"
    },
    {
      "id": "d7e3b3d4-c9f4-4f26-906d-4e5b1832a3b3",
      "date": "2026-10-20",
      "title": "Threshold + Sled Work",
      "focus": "Stations",
      "notes": "Threshold = \"comfortably hard\". You should only manage 3–4 words at a time.",
      "duration": 60,
      "blocks": [
        {
          "title": "Warm-up",
          "format": "10 min",
          "details": "5 min easy SkiErg\nHip airplanes, world’s greatest stretch\n2 × 10 m light sled push + pull"
        },
        {
          "title": "Sled Skill",
          "format": "6 sets · rest 1:30",
          "details": "15 m sled push (race weight +10%)\n15 m sled pull, hand-over-hand\nLow hips, short choppy steps, arms locked",
          "pbEvent": "sled_push_50"
        },
        {
          "title": "Threshold Row",
          "format": "5 × 1000 m · rest 1:30",
          "details": "Pace you could hold for ~20 min\nDamper 5–6, rate 26–30\nLog your fastest 1000 m",
          "pbEvent": "row_1000"
        },
        {
          "title": "Accessory",
          "format": "3 rounds",
          "details": "12 single-arm DB rows / side\n30 s hollow hold\n10 Copenhagen plank lifts / side"
        }
      ],
      "published": true,
      "createdAt": "2026-10-30T02:59:08.941Z"
    },
    {
      "id": "7d7ea649-839e-4890-a0fd-918d90d23e6f",
      "date": "2026-10-21",
      "title": "Aerobic Base",
      "focus": "Zone 2",
      "notes": "Easy means easy. This session builds the engine that makes Friday possible.",
